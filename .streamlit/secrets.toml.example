# Copy this file to .streamlit/secrets.toml for local hosted-mode testing
# (that file is gitignored — never commit real keys). On Streamlit
# Community Cloud, paste the same key = "value" lines into the app's
# Settings -> Secrets panel instead of committing a file at all.
#
# If GEMINI_API_KEY and FIGMA_TOKEN are both set, the app runs in "hosted"
# mode: every visitor uses these, and the sidebar credential fields disappear.
# Leave this file absent (or these two keys unset) to keep the app in
# bring-your-own-key mode instead.

GEMINI_API_KEY = "your-gemini-api-key"
FIGMA_TOKEN = "your-figma-personal-access-token"

# Comma-separated list of Figma file keys this app is allowed to read in
# hosted mode. Required whenever FIGMA_TOKEN is shared publicly — without it,
# any visitor could use your token to read any file you have access to, not
# just the ones you intend to expose. The file key is the segment of a Figma
# URL right after /design/ or /file/, e.g. for
# https://www.figma.com/design/abc123XYZ/My-File the key is "abc123XYZ".
FIGMA_ALLOWED_FILE_KEYS = "abc123XYZ,def456UVW"
